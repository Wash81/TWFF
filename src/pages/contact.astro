---
import ContactForm from '../components/forms/ContactForm.astro';
import Layout from '../layouts/Page.astro';
import SealMark from '../components/SealMark.astro';
import settings from '../config/settings';

const seo = {
	title: 'Contact | The Washington Family Foundation',
	description: 'Get in touch with The Washington Family Foundation.',
};
---

<Layout seo={seo}>
	<section class="contact">
		<div class="contact__inner">
			<div class="contact__panel on-navy">
				<p class="eyebrow">Contact</p>
				<h1>We'd love to hear from you</h1>
				<hr class="gold-rule" />
				<p>
					Whether you want to donate, volunteer, partner with us, or learn about our
					programs for your family, send us a note.
				</p>
				<p class="contact__email"><span>Email</span><a href={`mailto:${settings.email}`}>{settings.email}</a></p>
				<div class="contact__seal"><SealMark ink="#FFFFFF" accent="#B8923A" size={110} decorative /></div>
			</div>
			<div class="contact__form">
				<ContactForm />
			</div>
		</div>
	</section>
</Layout>

<style>
	.contact__inner {
		max-width: 1200px; margin: 0 auto; padding: 64px 24px;
		display: grid; grid-template-columns: 1fr 1fr; gap: 48px;
	}
	.contact__panel {
		position: relative; padding: 40px; background: var(--brand-navy); color: var(--brand-on-navy-muted);
		display: flex; flex-direction: column; justify-content: center;
	}
	.contact__panel h1 { color: #FFFFFF; font-size: clamp(1.9rem, 3.4vw, 2.6rem); text-wrap: balance; }
	.contact__panel p { line-height: 1.6; }
	.contact__email { display: flex; flex-direction: column; gap: 4px; margin-top: 0.5rem; }
	.contact__email span { font-size: 13px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: var(--brand-gold-light); }
	.contact__email a { color: #FFFFFF; font-size: 1.2rem; font-weight: 700; }
	.contact__seal { margin-top: 1.5rem; }
	.contact__form { display: flex; flex-direction: column; justify-content: center; min-width: 0; }
	@media (max-width: 768px) {
		.contact__inner { grid-template-columns: 1fr; padding: 32px 16px 48px; }
		.contact__panel { padding: 32px 24px; }
	}
</style>
