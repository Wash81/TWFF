---
import { Button, TextCardSection } from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';

const seo = {
	title: 'Thank You | The Washington Family Foundation',
	description: 'Thanks for reaching out to The Washington Family Foundation.',
};
---

<Layout {seo}>
	<TextCardSection>
		<h1>Thank you!</h1>
		<p>We received your message and will be in touch soon.</p>
		<Button href="/">Return Home</Button>
	</TextCardSection>
</Layout>
