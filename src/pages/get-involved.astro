---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Page.astro';
import PageIntro from '../components/sections/PageIntro.astro';
import settings from '../config/settings';

const seo = {
	title: 'Get Involved | The Washington Family Foundation',
	description: 'Donate, volunteer, or partner with The Washington Family Foundation.',
};
const ways = [
	{ id: 'donate', icon: 'mdi:hand-heart-outline', color: 'var(--brand-coral)', title: 'Donate',
	  text: 'Every gift helps a child get tutoring, an adult earn a credential, or a family connect to essential resources. Contact us to make a gift or learn about recurring giving.',
	  cta: 'Make a gift' },
	{ id: 'volunteer', icon: 'mdi:account-group-outline', color: 'var(--brand-sky)', title: 'Volunteer',
	  text: 'Share your time and talents as a tutor, mentor, career coach, or helper at our community outreach events.',
	  cta: 'Volunteer with us' },
	{ id: 'partner', icon: 'mdi:handshake-outline', color: 'var(--brand-gold)', title: 'Partner With Us',
	  text: 'Schools, employers, funders, and community organizations: work with us to expand opportunity for families in underserved communities.',
	  cta: 'Start a conversation' },
];
---

<Layout {seo}>
	<PageIntro eyebrow="Get involved" title="Strong communities are built together">
		<p>Here is how you can help families build skills, stability, and support.</p>
	</PageIntro>

	<section class="ways">
		<div class="ways__inner">
			{ways.map((w) => (
				<article id={w.id} class="way" style={`--way-color: ${w.color}`}>
					<span class="way__icon"><Icon name={w.icon} width={26} height={26} /></span>
					<h2>{w.title}</h2>
					<p>{w.text}</p>
					<a class="btn-navy" href={`/contact?interest=${w.id}`}>{w.cta}</a>
				</article>
			))}
		</div>
		<p class="ways__email">Prefer email? Write to us at <a href={`mailto:${settings.email}`}>{settings.email}</a>.</p>
	</section>
</Layout>

<style>
	.ways { background: var(--brand-ivory); padding: 72px 24px; }
	.ways__inner {
		max-width: 1200px; margin: 0 auto;
		display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;
	}
	.way {
		scroll-margin-top: 1rem; padding: 30px; background: #FFFFFF; border-top: 6px solid var(--way-color);
		display: flex; flex-direction: column; align-items: flex-start;
	}
	.way h2 { font-family: var(--theme-font-family-sans); font-weight: 900; letter-spacing: 0; font-size: 1.6rem; margin-top: 1rem; }
	.way p { flex: 1; line-height: 1.6; color: #2A3240; }
	.way__icon {
		display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 50%;
		background: var(--brand-navy); color: #FFFFFF;
	}
	.ways__email { max-width: 1200px; margin: 2rem auto 0; color: #2A3240; }
	.ways__email a { color: var(--brand-navy); font-weight: 700; }
	@media (max-width: 600px) { .ways { padding: 48px 16px; } }
</style>
