---
import { CtaCardSection, TextCardSection, Button } from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';
import HomeHeroSection from '../components/sections/heros/HomeHeroSection.astro';
import PillarsSection from '../components/sections/PillarsSection.astro';
---

<Layout>
	<HomeHeroSection />

	<TextCardSection>
		<h2>Our mission</h2>
		<p class="lead">
			The Washington Family Foundation creates pathways to opportunity for children
			and adults in underserved communities. Through education, workforce training,
			and community outreach, we help families build skills, stability, and the
			support they need to thrive, today and for generations to come.
		</p>
		<Button href="/about" unelevated>About the Foundation</Button>
	</TextCardSection>

	<PillarsSection>
		<h2>Three pillars, one goal</h2>
		<p>
			We advance our mission through three pillars that support every member of
			the family, from the classroom to the workplace to the neighborhood.
		</p>
	</PillarsSection>

	<CtaCardSection background="var(--theme-primary)" color="var(--theme-on-primary)">
		<h2>A future where every family can thrive</h2>
		<p>
			We envision communities where every child and adult has a fair chance to
			succeed, no matter their zip code, income, or circumstances.
		</p>
		<div class="cta-btns">
			<a class="cta-link" href="/get-involved#donate">Donate</a>
			<a class="cta-link cta-link--ghost" href="/get-involved#volunteer">Volunteer</a>
		</div>
	</CtaCardSection>
</Layout>

<style>
	.lead { font-size: var(--font-size-md); }
	.cta-btns { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; margin-top: 0.5rem; }
	.cta-link {
		padding: 0.75rem 1.5rem;
		border-radius: var(--theme-button-border-radius);
		background: var(--theme-on-primary);
		color: var(--theme-primary);
		font-weight: 700;
		text-decoration: none;
	}
	.cta-link--ghost {
		background: transparent;
		color: var(--theme-on-primary);
		box-shadow: inset 0 0 0 2px var(--theme-on-primary);
	}
	.cta-link:hover { opacity: 0.88; }
</style>
