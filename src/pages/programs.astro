---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Page.astro';
import PageIntro from '../components/sections/PageIntro.astro';
import GiveBand from '../components/sections/GiveBand.astro';
import { pillars } from '../config/pillars.js';

const seo = {
	title: 'Programs | The Washington Family Foundation',
	description: 'Education and youth development, workforce and economic mobility, and family and community wellness.',
};
const images = {
	workforce: { src: '/assets/images/landing-1/landing-hero-1.jpg', alt: 'An adult working on a laptop in a bright workspace' },
};
---

<Layout {seo}>
	<PageIntro eyebrow="Programs" title="Our Programs">
		<p>
			Our work is organized around three pillars that meet families where they are,
			supporting children, adults, and the communities they call home.
		</p>
	</PageIntro>

	{pillars.map((p, i) => (
		<section id={p.id} class:list={['program', { 'program--ivory': i % 2 === 1 }]} style={`--pillar-color: ${p.color}`}>
			<div class:list={['program__inner', { 'program__inner--flip': i % 2 === 1 }]}>
				<div class="program__text">
					<span class="program__icon"><Icon name={p.icon} width={30} height={30} /></span>
					<p class="eyebrow">Pillar {i + 1}</p>
					<h2>{p.title}</h2>
					<p>{p.body}</p>
				</div>
				<div class="program__aside">
					{images[p.id] ? (
						<img src={images[p.id].src} alt={images[p.id].alt} loading="lazy" />
					) : (
						<div class="program__list">
							<p class="program__list-title">What we offer</p>
							<ul>{p.offerings.map((o) => <li>{o}</li>)}</ul>
						</div>
					)}
				</div>
			</div>
		</section>
	))}

	<GiveBand title="Help us reach more families" text="Your support funds tutoring, job training, and community wellness programs." />
</Layout>

<style>
	.program { scroll-margin-top: 1rem; }
	.program--ivory { background: var(--brand-ivory); }
	.program__inner {
		max-width: 1200px; margin: 0 auto; padding: 72px 24px;
		display: grid; grid-template-columns: 1.2fr 1fr; gap: 48px; align-items: center;
	}
	.program__inner--flip .program__text { order: 2; }
	.program__text { min-width: 0; }
	.program__text h2 { font-size: clamp(1.7rem, 3vw, 2.3rem); text-wrap: balance; }
	.program__text p:last-child { font-size: 1.1rem; line-height: 1.7; color: #2A3240; }
	.program__icon {
		display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%;
		background: var(--brand-navy); color: #FFFFFF; margin-bottom: 1.25rem;
	}
	.program__aside img { display: block; width: 100%; max-height: 420px; object-fit: cover; border-top: 6px solid var(--pillar-color); }
	.program__list { padding: 32px; background: #FFFFFF; border: 1px solid var(--brand-line); border-top: 6px solid var(--pillar-color); }
	.program__list-title { font-weight: 900; font-size: 1.2rem; }
	.program__list ul { margin: 0; padding-left: 1.2rem; }
	.program__list li { margin-bottom: 0.6rem; font-size: 1.05rem; }
	.program__list li::marker { color: var(--brand-gold); }
	@media (max-width: 768px) {
		.program__inner { grid-template-columns: 1fr; padding: 48px 16px; gap: 28px; }
		.program__inner--flip .program__text { order: 0; }
	}
</style>
