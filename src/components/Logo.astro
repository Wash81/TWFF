---
import SealMark from './SealMark.astro';
interface Props { reversed?: boolean; size?: number; }
const { reversed = false, size = 52 } = Astro.props;
---

<span class:list={['twff-logo', { 'twff-logo--reversed': reversed }]}>
	<SealMark ink={reversed ? '#FFFFFF' : '#1C2B4A'} accent="#B8923A" size={size} decorative />
	<span class="twff-logo__word">The Washington<br />Family Foundation</span>
</span>

<style>
	.twff-logo {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		color: var(--brand-navy);
	}
	.twff-logo--reversed { color: #FFFFFF; }
	@media (max-width: 600px) { .twff-logo__word { font-size: 12px; letter-spacing: 1px; } }
	.twff-logo__word {
		font-family: var(--theme-font-family-serif);
		font-size: 15px;
		font-weight: 700;
		letter-spacing: 1.5px;
		line-height: 1.3;
		text-transform: uppercase;
	}
</style>
