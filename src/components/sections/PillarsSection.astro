---
import { Icon } from 'astro-icon/components';
import { Container } from '@components/odyssey-theme';
import { pillars } from '../../config/pillars.js';
const { linked = true } = Astro.props;
---

<Container>
	<section class="pillars__section">
		<slot />
		<div class="pillars__grid">
			{pillars.map((p, i) => (
				<article class="pillar">
					<span class="pillar__icon"><Icon name={p.icon} width={28} height={28} /></span>
					<p class="pillar__num">Pillar {i + 1}</p>
					<h3>{p.title}</h3>
					<p>{p.summary}</p>
					{linked && <a href={`/programs#${p.id}`}>Learn more<span class="visually-hidden"> about {p.title}</span> →</a>}
				</article>
			))}
		</div>
	</section>
</Container>

<style>
	.pillars__section {
		margin: var(--section-margin) auto;
	}
	.pillars__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--theme-grid-gap);
	}
	.pillar {
		padding: 2rem;
		background: var(--theme-surface-2);
		color: var(--theme-on-surface-2);
		border-radius: var(--theme-shape-radius);
		display: flex;
		flex-direction: column;
	}
	.pillar h3 { margin-top: 0.25rem; }
	.pillar a { margin-top: auto; font-weight: 700; color: var(--theme-primary); }
	.pillar__icon {
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		border-radius: 50%;
		background: var(--theme-primary);
		color: var(--theme-on-primary);
	}
	.pillar__num {
		margin: 1rem 0 0;
		font-size: var(--font-size-sm);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		opacity: 0.75;
	}
	.visually-hidden {
		position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
	}
	@media (max-width: 900px) {
		.pillars__grid { grid-template-columns: 1fr; }
	}
</style>
