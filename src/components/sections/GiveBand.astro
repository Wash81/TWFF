---
const { title = 'Give. Volunteer. Partner.', text = "There's a place for everyone in this work. Choose the way that fits you." } = Astro.props;
---

<section class="give">
	<div class="give__inner">
		<div class="give__text">
			<h2>{title}</h2>
			<p>{text}</p>
		</div>
		<div class="give__btns">
			<a class="btn-navy" href="/get-involved#donate">Donate</a>
			<a class="btn-outline-navy" href="/get-involved#volunteer">Volunteer</a>
		</div>
	</div>
</section>

<style>
	.give { background: var(--brand-coral); color: var(--brand-navy); }
	.give__inner {
		max-width: 1200px; margin: 0 auto; padding: 64px 24px;
		display: flex; flex-wrap: wrap; gap: 28px; align-items: center; justify-content: space-between;
	}
	.give__text { flex: 1 1 420px; min-width: 0; }
	.give h2 { font-family: var(--theme-font-family-sans); font-weight: 900; letter-spacing: 0; margin-bottom: 0.5rem; }
	.give p { margin: 0; font-size: 1.1rem; line-height: 1.6; }
	.give__btns { display: flex; flex-wrap: wrap; gap: 12px; }
	@media (max-width: 600px) { .give__inner { padding: 48px 16px; } }
</style>
