---
import { Header, Footer } from '@components/odyssey-theme';
import Layout from './Base.astro';
import type { Props as BaseHeadProps } from '../components/head/BaseHead.astro';
import Logo from '../components/Logo.astro';
import settings from '../config/settings';
import { footerLists, footerSocials } from '../config/footer';
import { nav } from '../config/nav.js';

export interface Props {
	seo?: BaseHeadProps;
}

const { seo } = Astro.props as Props;
---

<Layout seo={seo}>
	<div class="site-header" slot="header">
		<Header rightMenu navData={nav}>
			<span slot="logo">
				<Logo />
			</span>
			<a slot="action-item" class="btn-coral" href="/get-involved#donate">Donate</a>
		</Header>
	</div>
	<div id="page">
		<slot />
	</div>
	<Footer
		slot="footer"
		background="var(--brand-navy)"
		color="var(--brand-on-navy-muted)"
		footerLists={footerLists}
		footerSocials={footerSocials}
		copyrightName={settings.name}
		showPlug={settings.showPlug}
	>
		<div slot="logo" class="footer-brand">
			<Logo reversed size={76} />
			<p class="footer-email"><a href={`mailto:${settings.email}`}>{settings.email}</a></p>
		</div>
	</Footer>
</Layout>

<style>
	.site-header {
		border-bottom: 1px solid var(--brand-line);
		background: #FFFFFF;
	}
	.site-header :global(header) {
		max-width: 1200px;
		margin: 0 auto;
		padding: 16px 24px;
	}
	.site-header :global(nav ul li a) {
		font-weight: 700;
		opacity: 1;
		color: var(--brand-navy);
	}
	.site-header :global(nav ul li a:hover) { color: var(--brand-gold-text); }
	.footer-brand { display: flex; flex-direction: column; gap: 12px; }
	.footer-email { margin: 0; }
	.footer-email a { color: #FFFFFF; }
	:global(footer a) { color: #FFFFFF; }
	:global(footer strong) { color: var(--brand-gold-light); letter-spacing: 0.08em; text-transform: uppercase; font-size: var(--font-size-sm); }
</style>
